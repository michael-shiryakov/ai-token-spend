# Copy this file to .env and fill in the keys for the providers you want to track.
# You only need the keys for the providers you actually use.

# Anthropic Analytics API key (Claude Enterprise) with the read:analytics scope.
# Create one at claude.ai/admin-settings/api-access
ANTHROPIC_ADMIN_KEY=

# OpenAI Admin API key with usage/cost read access.
# Create one at platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=
